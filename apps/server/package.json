{
  "name": "@familycloud/server",
  "version": "0.8.1",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "dev:worker": "tsx watch --env-file-if-exists=../../.env src/worker.ts",
    "dev:db": "tsx scripts/dev-db.ts",
    "cli": "tsx --env-file-if-exists=../../.env src/cli.ts",
    "build": "tsup",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@familycloud/shared": "workspace:*",
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.1.2",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.5",
    "@fastify/swagger": "^9.9.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@node-rs/argon2": "^2.2.2",
    "@simplewebauthn/server": "^14.0.3",
    "drizzle-orm": "^0.45.4",
    "exifr": "^7.1.3",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "lru-cache": "^11.5.3",
    "otpauth": "^9.5.2",
    "pg-boss": "^12.37.1",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "proxy-addr": "^2.0.8",
    "sharp": "^0.35.5",
    "uuidv7": "^1.2.1",
    "yazl": "^3.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/proxy-addr": "^2.0.3",
    "@types/yazl": "^3.3.1",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "18.4.0-beta.17",
    "pino-pretty": "^13.2.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "vitest": "^5.0.3"
  }
}

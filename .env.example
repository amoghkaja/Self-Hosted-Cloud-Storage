# Local development settings (copy to .env). Production uses deploy/.env instead.
NODE_ENV=development
PUBLIC_URL=http://localhost:5173
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54320/familycloud
# Relative to apps/server when running `pnpm dev`.
DATA_DIR=../../.dev-data
# Generate your own: openssl rand -hex 32
SECRET_KEY=dev-only-secret-change-me-0123456789abcdef
LOG_LEVEL=info

{
  "name": "familycloud",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted family cloud storage: accounts, quotas, multi-disk volumes, sharing.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @familycloud/server --filter @familycloud/web dev",
    "dev:db": "pnpm --filter @familycloud/server dev:db",
    "build": "pnpm --filter @familycloud/web build && pnpm --filter @familycloud/server build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^24.13.6",
    "typescript": "^7.0.2"
  }
}

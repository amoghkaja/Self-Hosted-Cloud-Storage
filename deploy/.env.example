# ── Family Cloud production settings ─────────────────────────────────────────
# scripts/install.sh creates this file for you. Never commit the filled-in .env.

# The address family members type into the browser.
PUBLIC_URL=https://cloud.example.com
APP_NAME=Family Cloud

# Secrets: generate with `openssl rand -hex 32`. Changing SECRET_KEY breaks everyone's
# two-factor setup and the display of existing share links; keep a copy with your backups.
SECRET_KEY=
POSTGRES_PASSWORD=

# Where everything lives on the host.
STORAGE_ROOT=/srv/familycloud
# Host user that owns STORAGE_ROOT (run `id -u` and `id -g`).
PUID=1000
PGID=1000

# Cloudflare Tunnel (profile: tunnel). Copy the token from Zero Trust → Networks → Tunnels.
CLOUDFLARE_TUNNEL_TOKEN=

# Caddy (profile: caddy). Your domain, with ports 80/443 forwarded to this machine.
DOMAIN=

# Virus scanning (profile: clamav). `clamav` uses the bundled scanner, which needs about 1.5 GB
# of memory; empty turns scanning off. Change it with scripts/virus-scan.sh on|off. For a scanner
# on another computer, see "Using your own scanner" in docs/virus-scanning.md.
CLAMAV_HOST=

# Editing Word, Excel and PowerPoint files in the browser (profile: office). The editor's own
# address, e.g. https://office.example.com; empty: not set up. It needs about 1–2 GB of memory.
# scripts/office.sh on|off sets these; Admin → Settings → Document editor turns it off and on
# (off removes the editor and gives the memory back). See docs/office-editing.md.
OFFICE_PUBLIC_URL=
# OFFICE_TLS=true        # whether OFFICE_PUBLIC_URL is https://
# OFFICE_DOMAIN=         # with Caddy: the editor's domain
# OFFICE_PORT=3081       # Tailscale and local installs: the editor's port on 127.0.0.1

# Optional services `docker compose` starts: tunnel, caddy, clamav, office, several
# (tunnel,clamav) or none. scripts/install.sh sets this from the settings above.
COMPOSE_PROFILES=

# Local port for LAN/Tailscale access (bound to 127.0.0.1 only).
APP_PORT=3080

# The image to run. scripts/update.sh pins it to each release it installs, e.g.
# ghcr.io/amoghkaja/self-hosted-cloud-storage:v0.1.0 (familycloud:local on the main channel).
IMAGE=ghcr.io/amoghkaja/self-hosted-cloud-storage:latest

# What scripts/update.sh follows: stable (the newest release) or main (latest code, built here).
UPDATE_CHANNEL=stable

# How updates happen (scripts/update.sh --updates … changes it, and the crontab with it):
#   auto    installed by themselves at night (around 4:30 by this computer's clock), with a
#           database backup first
#   notify  shown in Admin → Overview; installed when you choose
#   manual  only when you run scripts/update.sh
# auto and notify add the update helper to your crontab, a line with a note saying what it is:
# every 6 hours it asks GitHub whether there's a new version, and it answers Admin → Overview.
UPDATES=notify

LOG_LEVEL=info

# Optional: share passkeys across subdomains by setting the parent domain (e.g. example.com for
# cloud.example.com). Defaults to PUBLIC_URL's host.
# PASSKEY_RP_ID=

# Where the source of the version you run is published (linked as "Source code" in the app).
# The AGPL license asks you to offer your changes to your users: if you run a modified copy,
# point this at your fork.
# SOURCE_URL=https://github.com/amoghkaja/Self-Hosted-Cloud-Storage

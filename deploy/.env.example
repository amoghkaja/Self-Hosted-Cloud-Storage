# ── Family Cloud production settings ─────────────────────────────────────────
# scripts/install.sh creates this file for you. Never commit the filled-in .env.

# The address family members type into the browser.
PUBLIC_URL=https://cloud.example.com
APP_NAME=Family Cloud

# Secrets: generate with `openssl rand -hex 32`. Changing SECRET_KEY signs everyone out
# and breaks existing share links and two-factor setups.
SECRET_KEY=
POSTGRES_PASSWORD=

# Where everything lives on the host.
STORAGE_ROOT=/srv/familycloud
# Host user that owns STORAGE_ROOT (run `id -u` and `id -g`).
PUID=1000
PGID=1000

# Cloudflare Tunnel (profile: tunnel). Copy the token from Zero Trust → Networks → Tunnels.
CLOUDFLARE_TUNNEL_TOKEN=

# Caddy (profile: caddy). Your domain, with ports 80/443 forwarded to this machine.
DOMAIN=

# Local port for LAN/Tailscale access (bound to 127.0.0.1 only).
APP_PORT=3080

# Pin a release instead of latest for predictable upgrades, e.g. ghcr.io/amoghkaja/cloud-storage:v0.1.0
IMAGE=ghcr.io/amoghkaja/cloud-storage:latest

LOG_LEVEL=info
